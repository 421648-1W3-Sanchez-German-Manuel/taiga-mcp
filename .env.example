# Copy this file to .env and fill in your values. Never commit .env.

# Taiga base API URL. Use https://api.taiga.io/api/v1 for taiga.io SaaS,
# or https://your-taiga-host/api/v1 for a self-hosted instance.
TAIGA_BASE_URL=https://api.taiga.io/api/v1

# Your Taiga login credentials.
TAIGA_USERNAME=
TAIGA_PASSWORD=

# Default project: either the slug (e.g. "myuser-myproject") or numeric id.
# Find it in the Taiga URL: https://tree.taiga.io/project/<slug>/
TAIGA_PROJECT=
